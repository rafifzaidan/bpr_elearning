{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Mobile App",
      "cwd": "${workspaceFolder}/mobile_app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Admin Web (Next.js)",
      "cwd": "admin_web",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"]
    }
  ]
}
